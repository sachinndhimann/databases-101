# Copy this file to .env and adjust as needed.

# Postgres
POSTGRES_USER=db101
POSTGRES_PASSWORD=db101pass
POSTGRES_DB=db101
POSTGRES_PORT=5432

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=db101
MYSQL_USER=db101
MYSQL_PASSWORD=db101pass
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379

# Adminer (web UI for browsing both DBs)
ADMINER_PORT=8080

# Connection strings used by Python scripts
POSTGRES_URL=postgresql+psycopg2://db101:db101pass@localhost:5432/db101
MYSQL_URL=mysql+pymysql://db101:db101pass@localhost:3306/db101
REDIS_URL=redis://localhost:6379/0
